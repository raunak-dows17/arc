# Ollama connection
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Model runtime (tuned for 16 GB RAM)
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_MS=180000

# Agent loop safety limits
MAX_AGENT_STEPS=12
MAX_CONTEXT_MESSAGES=16
MAX_CONTEXT_CHARS=16000
MAX_OBSERVATION_CHARS=4000
MAX_MEMORY_CHARS=6000
MAX_SKILL_INDEX_CHARS=2500
KEEP_RECENT_MESSAGES=8
MEMORY_AUTO_CAPTURE=true

# Private agent state (memory, skills, profiles, sessions, audit)
AGENT_HOME=./.agent-home
AGENT_PROFILE=assistant

# Filesystem workspace exposed to file tools
WORKSPACE_DIR=./sandbox
# SANDBOX_DIR=./sandbox  # legacy alias, used when WORKSPACE_DIR is unset

# Sequential sub-agents
MAX_SUBAGENT_STEPS=8
MAX_SUBAGENT_DEPTH=1
MAX_SUBAGENTS_PER_TURN=2
MAX_SUBAGENT_RUN_MS=300000
