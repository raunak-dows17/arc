# ARC — Autonomous Regenerative Companion
# Copy to .env and edit. Keep secrets in the OS credential store, never here.

# ── Private state and workspace ─────────────────────────────────────────────
# Windows production example:
#   ARC_HOME=C:\Users\Raunak Pandey\AppData\Local\ARC\agent-home
#   ARC_WORKSPACE=C:\Users\Raunak Pandey\Projects
# ARC_HOME must stay outside ARC_WORKSPACE.
ARC_HOME=./.arc
ARC_WORKSPACE=./sandbox
ARC_PROFILE=arc

# ── Local models (Ollama) ───────────────────────────────────────────────────
ARC_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARC_MODEL=qwen3:8b
ARC_CODING_MODEL=qwen2.5-coder:7b
ARC_RESEARCH_MODEL=qwen3:8b
ARC_DECISION_MODEL=tev1:0.8b
ARC_DECISION_BASE_URL=http://127.0.0.1:11434

# 16 GB RAM profile: one model at a time, 8K context.
ARC_NUM_CTX=8192
ARC_NUM_PREDICT=1024
ARC_TEMPERATURE=0.2
ARC_TOP_P=0.9
ARC_KEEP_ALIVE=10m
ARC_TIMEOUT_MS=180000

# Ollama itself should also be limited (set in the Ollama service environment):
#   OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_NUM_PARALLEL=1

# ── Bounded agent loop ──────────────────────────────────────────────────────
ARC_MAX_AGENT_STEPS=12
ARC_MAX_CONTEXT_MESSAGES=16
ARC_MAX_CONTEXT_CHARS=16000
ARC_MAX_OBSERVATION_CHARS=4000
ARC_MAX_MEMORY_CHARS=6000
ARC_MAX_SKILL_INDEX_CHARS=2500
ARC_KEEP_RECENT_MESSAGES=8
ARC_MEMORY_AUTO_CAPTURE=true

# ── Sequential sub-agents ───────────────────────────────────────────────────
ARC_MAX_SUBAGENT_STEPS=8
ARC_MAX_SUBAGENT_DEPTH=1
ARC_MAX_SUBAGENTS_PER_TURN=2
ARC_MAX_SUBAGENT_RUN_MS=300000

# ── Web tools (Brave Search + safe fetch) ───────────────────────────────────
# Store the Brave key in the OS credential store, not here:
#   arc secrets set brave.api-key
ARC_WEB_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
ARC_WEB_SEARCH_TIMEOUT_MS=15000
ARC_WEB_FETCH_TIMEOUT_MS=20000
ARC_WEB_MAX_BYTES=524288
ARC_WEB_MAX_CHARS=20000
ARC_WEB_MAX_REDIRECTS=3
ARC_WEB_CACHE_TTL_MS=300000
ARC_WEB_MAX_RESULTS=8

# ── Approval-gated shell ────────────────────────────────────────────────────
# Every shell command still requires interactive approval, regardless of these
# limits. On Windows the shell tool uses PowerShell.
ARC_SHELL_TIMEOUT_MS=60000
ARC_SHELL_MAX_OUTPUT_BYTES=65536

# ── Read-only Gmail IMAP ingestion ──────────────────────────────────────────
# Store the Google app password in the OS credential store, not here:
#   arc secrets set gmail.app-password
# ARC uses EXAMINE/read-only and BODY.PEEK; it never marks mail as read.
ARC_EMAIL_ENABLED=false
ARC_EMAIL_ADDRESS=
ARC_EMAIL_IMAP_HOST=imap.gmail.com
ARC_EMAIL_IMAP_PORT=993
ARC_EMAIL_MAILBOX=INBOX
ARC_EMAIL_POLL_INTERVAL_MS=300000
ARC_EMAIL_LOOKBACK_DAYS=2
ARC_EMAIL_MAX_MESSAGES=10
ARC_EMAIL_SNIPPET_CHARS=800
ARC_EMAIL_TRIAGE_THRESHOLD=0.65
ARC_EMAIL_NOTIFY_ON_TRIAGE_FAILURE=true

# ── Telegram remote chat and notifications ──────────────────────────────────
# Store the bot token in the OS credential store, not here:
#   arc secrets set telegram.bot-token
# Only these numeric chat ids may talk to the bot. The first id is the default
# notification destination unless ARC_TELEGRAM_NOTIFY_CHAT_ID is set.
ARC_TELEGRAM_ENABLED=false
ARC_TELEGRAM_ALLOWED_CHAT_IDS=
ARC_TELEGRAM_NOTIFY_CHAT_ID=
ARC_TELEGRAM_POLL_TIMEOUT_SEC=30
