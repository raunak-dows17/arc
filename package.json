{
  "name": "autonomous_agent",
  "version": "1.0.0",
  "description": "Clean Architecture Autonomous AI Agent CLI",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "NODE_ENV=development tsx src/index.ts",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start:prod": "npm run build && NODE_ENV=production node out/index.js",
    "test": "npm run test:dev",
    "test:dev": "NODE_ENV=development tsx --test src/infrastructure/cli/ui/terminal.renderer.test.ts src/infrastructure/ai/ollama-llm.adapter.test.ts src/infrastructure/persistence/file-recovery.store.test.ts",
    "test:prod": "NODE_ENV=production tsx --test src/infrastructure/cli/ui/terminal.renderer.test.ts src/infrastructure/ai/ollama-llm.adapter.test.ts src/infrastructure/persistence/file-recovery.store.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "clean-architecture",
    "ollama"
  ],
  "type": "module",
  "dependencies": {
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
